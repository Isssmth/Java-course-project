#!/bin/sh
# Lightweight Maven wrapper launcher. Downloads Maven if not already cached.
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_VERSION="3.9.11"
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="${MAVEN_HOME}/apache-maven-${MAVEN_VERSION}/bin/mvn"
if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven Wrapper distribution is not installed."
  echo "Please use the Maven wrapper generated by Spring Initializr, or run 'mvn' if Maven is installed."
  exit 1
fi
exec "$MAVEN_BIN" "$@"
